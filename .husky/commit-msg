# Warn when the commit message does not follow Conventional Commits.
# This hook never blocks the commit.
if ! npx --no -- commitlint --edit "$1"; then
  echo ""
  echo "warning: the commit message does not follow Conventional Commits."
  echo "         e.g. 'feat(extension): add ...', 'fix: ...'"
  echo "         See https://www.conventionalcommits.org/"
fi
exit 0
